{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix react",
  "buildCommand": "npm run build --prefix react",
  "outputDirectory": "react/dist",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
